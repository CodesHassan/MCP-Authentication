# ============================================================
# TESTING VALUES ONLY - production mein real secrets use karein
# (secret manager se), aur is file ko git mein commit na karein.
# ============================================================

# ---- Common (Auth Server + MCP Server + Client) ----
IS_PRODUCTION=false
AUTH_SERVER_URL=http://localhost:9000
AUTH_ISSUER=http://localhost:9000
MCP_AUDIENCE=mcp-secure-server
MCP_SERVER_URL=http://localhost:8000/mcp

# ---- Auth Server ----
AUTH_HOST=127.0.0.1
AUTH_PORT=9000
PRIVATE_KEY_PATH=keys/private_key.pem
JWT_KEY_ID=key-1
REFRESH_AUDIENCE=auth-server-refresh
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000

# Demo users ke passwords (sirf testing ke liye)
ALICE_PASSWORD=alice-pass-123
BOB_PASSWORD=bob-pass-123

# ---- MCP Server ----
MCP_HOST=127.0.0.1
MCP_PORT=8000

# ---- Client (LLM) ----
# OpenAI ya koi bhi OpenAI-compatible provider (jaise OpenRouter) chalega.
# Neeche dummy key hai. LLM wala demo chalane ke liye real key daalein.
# "python client.py --direct" mode mein LLM ki zaroorat nahi.
LLM_API_KEY=sk-test-dummy-key-change-me
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
